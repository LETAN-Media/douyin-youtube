# backend_drama example env. Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
PORT=8080

# Admin token for /api/drama/* (generate a long random string).
DRAMA_ADMIN_TOKEN=

# Local SQLite file (default). Leave DRAMA_TURSO_URL empty for local dev.
# Production shared storage (later phase):
# DRAMA_TURSO_URL=file:/data/drama.sqlite3
# DRAMA_TURSO_TOKEN=

# RapidIX (RapidAPI marketplace, ReelShort unofficial). Key stays in env.
RAPIDIX_KEY=
RAPIDAPI_HOST=reelshort-unofficial-api.p.rapidapi.com
RAPIDAPI_BASE_URL=https://reelshort-unofficial-api.p.rapidapi.com
# Exact endpoint paths from the provider playground code snippets.
# Until set, provider calls refuse with NOT_CONFIGURED (no quota burned).
RAPIDIX_SEARCH_PATH=
RAPIDIX_EPISODES_PATH=
RAPIDIX_EPISODE_PATH=
RAPIDIX_TIMEOUT_SECONDS=30

# Short Drama Pro hub (multi-provider). Same RapidAPI account key works
# if subscribed; otherwise per-provider calls 403.
DRAMA_API_HOST=short-drama-pro.p.rapidapi.com
DRAMA_API_KEY=
DRAMA_API_BASE_URL=https://short-drama-pro.p.rapidapi.com
DRAMA_API_TIMEOUT_SECONDS=30

# Provider failover pool: 1 primary + up to 4 fallbacks. Each slot needs
# HOST + KEY (BASE_URL defaults to https://{HOST}). Unset slots are skipped.
# Optional _PROVIDERS limits a slot to content providers (comma-separated).
# Legacy DRAMA_API_HOST/BASE_URL/KEY act as the primary slot.
DRAMA_API_PRIMARY_NAME=short_drama_pro
DRAMA_API_PRIMARY_HOST=
DRAMA_API_PRIMARY_BASE_URL=
DRAMA_API_PRIMARY_KEY=
# DRAMA_API_PRIMARY_PROVIDERS=
DRAMA_API_FALLBACK_1_NAME=
DRAMA_API_FALLBACK_1_HOST=
DRAMA_API_FALLBACK_1_BASE_URL=
DRAMA_API_FALLBACK_1_KEY=
# DRAMA_API_FALLBACK_1_PROVIDERS=
DRAMA_API_FALLBACK_2_NAME=
DRAMA_API_FALLBACK_2_HOST=
DRAMA_API_FALLBACK_2_BASE_URL=
DRAMA_API_FALLBACK_2_KEY=
DRAMA_API_FALLBACK_3_NAME=
DRAMA_API_FALLBACK_3_HOST=
DRAMA_API_FALLBACK_3_BASE_URL=
DRAMA_API_FALLBACK_3_KEY=
DRAMA_API_FALLBACK_4_NAME=
DRAMA_API_FALLBACK_4_HOST=
DRAMA_API_FALLBACK_4_BASE_URL=
DRAMA_API_FALLBACK_4_KEY=
