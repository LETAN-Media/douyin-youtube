DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

PUBLIC_BASE_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CORS_ORIGINS=*

WORKER_ENABLED=true
WORKER_POLL_SECONDS=5

TEMP_DIR=/tmp/douyin-youtube

# Rcuts Douyin parser (centralized, no /root/shortcut-douyin dependency)
RCUTS_API=http://api.rcuts.com/Video/DouYin.php
RCUTS_PRIMARY_API=http://api.rcuts.com/Video/DouYin_All.php
RCUTS_FALLBACK_API=http://api.rcuts.com/Video/DouYin.php

# Optional:
# base64 -w 0 cookies.txt
DOUYIN_COOKIES_B64=

# RapidAPI Douyin creator feed (PRIMARY, no Douyin cookie, no Playwright)
# Provider: "Douyin/China Tiktok All API" by justoneapi on RapidAPI.
# User posts endpoint: /api/douyin/get-user-video-list/v3 (secUid + maxCursor).
# Creator scanner primary selection:
DOUYIN_CREATOR_PROVIDER=rapidapi_justone
RAPIDAPI_KEY=
DOUYIN_RAPIDAPI_HOST=
DOUYIN_RAPIDAPI_BASE_URL=
DOUYIN_RAPIDAPI_USER_POSTS_PATH=/api/douyin/get-user-video-list/v3
DOUYIN_RAPIDAPI_ENABLED=true
# Max feed pages fetched per scan (1-3)
DOUYIN_MAX_PAGES_PER_SCAN=3
