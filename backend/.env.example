DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# MUST be the public HTTPS domain; OAuth redirect_uri is
# PUBLIC_BASE_URL + /auth/youtube/callback and must match Google Cloud Console.
PUBLIC_BASE_URL=https://douyin-api.toolnet.tech

# Optional: where the OAuth callback redirects after success.
# FRONTEND_URL=https://douyin.toolnet.tech

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CORS_ORIGINS=*

WORKER_ENABLED=true
WORKER_POLL_SECONDS=5

# Scheduler runs each cycle in an isolated child process with a hard timeout.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
SCHEDULER_CYCLE_TIMEOUT_SECONDS=180

TEMP_DIR=/tmp/douyin-youtube

# Rcuts Douyin parser (centralized, no /root/shortcut-douyin dependency)
RCUTS_API=http://api.rcuts.com/Video/DouYin.php
RCUTS_PRIMARY_API=http://api.rcuts.com/Video/DouYin_All.php
RCUTS_FALLBACK_API=http://api.rcuts.com/Video/DouYin.php

# Optional:
# base64 -w 0 cookies.txt
DOUYIN_COOKIES_B64=

# =====================================================================
# RAPIDAPI MULTI-PROVIDER CONFIGURATION (Primary + 3 Fallbacks)
# =====================================================================
# SIMPLIFIED MODEL: All 4 RapidAPI keys map to the SAME API host:
#   douyin-china-tiktok-all-api.p.rapidapi.com
# Single adapter: justone_v3
# Each key has its own quota record. Primary is tried first; if it fails
# (timeout, server error, quota exhausted), failover proceeds in order:
#   Primary -> Fallback 1 -> Fallback 2 -> Fallback 3
# A slot with empty HOST or KEY is DISABLED (not activated).
#
# PRIMARY (required for RapidAPI discovery):
DOUYIN_RAPIDAPI_PRIMARY_HOST=douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_PRIMARY_KEY=
DOUYIN_RAPIDAPI_PRIMARY_BASE_URL=https://douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_PRIMARY_USER_POSTS_PATH=/api/douyin/get-user-video-list/v3
DOUYIN_RAPIDAPI_PRIMARY_SCHEMA=justone_v3
DOUYIN_RAPIDAPI_PRIMARY_TIMEOUT_SECONDS=30
DOUYIN_RAPIDAPI_PRIMARY_MAX_RETRIES=2
DOUYIN_RAPIDAPI_PRIMARY_MONTHLY_REQUEST_LIMIT=20

# FALLBACK 1 (same host, different key for failover):
DOUYIN_RAPIDAPI_FALLBACK_1_HOST=douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_1_KEY=
DOUYIN_RAPIDAPI_FALLBACK_1_BASE_URL=https://douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_1_USER_POSTS_PATH=/api/douyin/get-user-video-list/v3
DOUYIN_RAPIDAPI_FALLBACK_1_SCHEMA=justone_v3
DOUYIN_RAPIDAPI_FALLBACK_1_TIMEOUT_SECONDS=30
DOUYIN_RAPIDAPI_FALLBACK_1_MAX_RETRIES=1
DOUYIN_RAPIDAPI_FALLBACK_1_MONTHLY_REQUEST_LIMIT=20

# FALLBACK 2 (same host, different key for failover):
DOUYIN_RAPIDAPI_FALLBACK_2_HOST=douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_2_KEY=
DOUYIN_RAPIDAPI_FALLBACK_2_BASE_URL=https://douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_2_USER_POSTS_PATH=/api/douyin/get-user-video-list/v3
DOUYIN_RAPIDAPI_FALLBACK_2_SCHEMA=justone_v3
DOUYIN_RAPIDAPI_FALLBACK_2_TIMEOUT_SECONDS=30
DOUYIN_RAPIDAPI_FALLBACK_2_MAX_RETRIES=1
DOUYIN_RAPIDAPI_FALLBACK_2_MONTHLY_REQUEST_LIMIT=20

# FALLBACK 3 (same host, different key for failover):
DOUYIN_RAPIDAPI_FALLBACK_3_HOST=douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_3_KEY=
DOUYIN_RAPIDAPI_FALLBACK_3_BASE_URL=https://douyin-china-tiktok-all-api.p.rapidapi.com
DOUYIN_RAPIDAPI_FALLBACK_3_USER_POSTS_PATH=/api/douyin/get-user-video-list/v3
DOUYIN_RAPIDAPI_FALLBACK_3_SCHEMA=justone_v3
DOUYIN_RAPIDAPI_FALLBACK_3_TIMEOUT_SECONDS=30
DOUYIN_RAPIDAPI_FALLBACK_3_MAX_RETRIES=1
DOUYIN_RAPIDAPI_FALLBACK_3_MONTHLY_REQUEST_LIMIT=20

# Legacy (kept for backward compat - DO NOT USE FOR NEW SETUP):
# RAPIDAPI_KEY=
# DOUYIN_RAPIDAPI_HOST=
# DOUYIN_RAPIDAPI_BASE_URL=
# DOUYIN_RAPIDAPI_USER_POSTS_PATH=

# RapidAPI quota guard (BASIC plan ~20 requests/month, one page each).
RAPIDAPI_MONTHLY_REQUEST_LIMIT=20
RAPIDAPI_QUOTA_SAFETY_MARGIN=1

# Initial full import (resumable backlog walk).
DOUYIN_INITIAL_IMPORT_MAX_PAGES=50
DOUYIN_INITIAL_IMPORT_PAGE_DELAY_SECONDS=0.5
# Manual refresh: max pages past the first known video.
DOUYIN_REFRESH_MAX_PAGES=3
# NEVER schedule Douyin creator discovery (quota is tiny). Scheduler reads
# Inventory only; leave this false unless doing a deliberate one-off backfill.
DOUYIN_AUTO_SCAN_ENABLED=false

# OPTIONAL, default OFF: generic http/playwright/yt-dlp fallbacks.
DOUYIN_CREATOR_FALLBACKS_ENABLED=false

# OPTIONAL, default OFF: self-hosted Douyin Feed API service
# (Evil0ctal Douyin_TikTok_Download_API v5).
# Max feed pages fetched per scan (1-3)
DOUYIN_MAX_PAGES_PER_SCAN=3

# OPTIONAL, default OFF: RevidAPI Douyin creator feed.
REVID_API_KEY=
REVID_SCAN_ENABLED=false

# =====================================================================
# AI YouTube Comment Reply (independent of publishing)
# =====================================================================
# Master switch for the whole comment subsystem + its own worker loop.
COMMENT_REPLY_ENABLED=true
COMMENT_SCAN_ENABLED=true
COMMENT_SCAN_INTERVAL_MINUTES=10
YOUTUBE_COMMENT_SCAN_INTERVAL_MINUTES=
COMMENT_WORKER_STARTUP_DELAY_SECONDS=15
COMMENT_SCAN_VIDEOS_PER_CHANNEL=5
COMMENT_THREADS_MAX_PAGES=2
COMMENT_REPLY_DAILY_LIMIT=20
COMMENT_REPLY_MIN_INTERVAL_SECONDS=180

COMMENT_REPLY_MODEL=groq/qwen/qwen3.8-27b
COMMENT_REPLY_FALLBACK_MODEL=gpt-oss-20b
COMMENT_REPLY_TEMPERATURE=0.3
COMMENT_REPLY_MAX_TOKENS=80

# NOTE: replying to comments requires the youtube.force-ssl OAuth scope.
# Channels connected before this scope was added must Reconnect.

# =====================================================================
# Multi-user / multi-tenant auth
# =====================================================================
SIGNUP_DISABLED=true
SESSION_TTL_SECONDS=2592000
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Dynamic upload scheduling: default is not a cap; Pipeline/Destination limits win.
SCHEDULER_MAX_DAILY_UPLOADS=1440
SCHEDULER_MIN_SLOT_INTERVAL_MINUTES=1
SCHEDULER_DAILY_UPLOAD_WARNING_THRESHOLD=20
# Optional project-level daily upload budget. 0 = remaining provider quota unknown.
# Provider quota errors pause uploads durably until the next Pacific midnight.
YOUTUBE_PROJECT_DAILY_UPLOAD_BUDGET=0
