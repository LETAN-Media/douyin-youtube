# backend_audio — copy to .env / Northflank environment. NEVER commit real values.
APP_ENV=production
PORT=8080
LOG_LEVEL=INFO

AUDIO_ADMIN_TOKEN=
AUDIO_TURSO_URL=https://backendaudio-audio-toolnet.aws-us-east-2.turso.io
AUDIO_TURSO_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUDIO_YOUTUBE_CALLBACK_URL=https://audio-api.toolnet.tech/api/audio/youtube/oauth/callback
AUDIO_DASHBOARD_URL=https://douyin.toolnet.tech
AUDIO_TOKEN_ENCRYPTION_KEY=

PHIMTAT_ENABLED=true
PHIMTAT_API_KEY=
PHIMTAT_API_BASE_URL=https://api.phimtat.vn/json/snapvideo.json
PHIMTAT_TIMEOUT_SECONDS=60
PHIMTAT_MAX_BYTES=524288000

TOOLNET_BASE_URL=https://api.toolnet.tech/v1
TOOLNET_API_KEY=
TOOLNET_MODEL=
TOOLNET_AI_ENABLED=true

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

AUDIO_WORKER_CONCURRENCY=1
AUDIO_RENDER_CONCURRENCY=1
AUDIO_FFMPEG_THREADS=2
AUDIO_JOB_TIMEOUT_SECONDS=7200
AUDIO_WORKDIR=/tmp/backend-audio/jobs
JIANYING_BRIDGE_DIR=
