SERVICE_NAME=backend-tiktok
VERSION=1.0.0
PORT=8000
LOG_LEVEL=INFO

ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

TURSO_DATABASE_URL=
TURSO_TOKEN=

TIKTOK_MEDIA_MAX_BYTES=1000000000

TIKTOK_SOURCE_API_BASE_URL=https://tiktok-api-xzze.onrender.com
