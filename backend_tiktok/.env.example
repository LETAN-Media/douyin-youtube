TIKTOK_SOURCE_TIMEOUT_SECONDS=120
TIKTOK_SOURCE_MAX_COUNT=30
TIKTOK_PROVIDER=source_api
TIKTOK_SOURCE_SCRAPER_ENABLED=true
TIKTOK_SCAN_WRITE_CHUNK=100

TIKTOK_MANUAL_RESOLVER=shortcut
PHIMTAT_ENABLED=true
PHIMTAT_API_KEY=
PHIMTAT_API_BASE_URL=https://api.phimtat.vn/json/snapvideo.json
PHIMTAT_REDIRECT_URL=https://api.phimtat.vn/snapvideo/red64.php
PHIMTAT_TIMEOUT_SECONDS=60
PHIMTAT_VER=8
PHIMTAT_MAX_BYTES=524288000

CORS_ORIGINS=*
TIKTOK_YOUTUBE_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AI_TOOLNET_URL=
AI_API_KEY=
AI_TOOLNET_MODEL=
AI_TOOLNET_FAILBACK_MODEL=
TOOLNET_AI_ENABLED=false
TOOLNET_TIMEOUT=60
TOOLNET_MAX_REQUESTS_PER_MINUTE=30
TOOLNET_MAX_TOKENS_PER_MINUTE=8000

TIKTOK_SCHEDULER_ENABLED=false
TIKTOK_SCHEDULER_BATCH_TIME=06:00
TIKTOK_SCHEDULER_POLL_SECONDS=30
TIKTOK_FLOW_CACHE_SECONDS=10
TIKTOK_SCHEDULE_STATUS_CACHE_SECONDS=40
TIKTOK_RECONCILE_ENABLED=false
TIKTOK_RECONCILE_POLL_SECONDS=300

TIKTOK_QUOTA_PAUSE_MINUTES=60
