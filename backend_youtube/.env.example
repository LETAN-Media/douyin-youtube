# backend_youtube - YouTube → Facebook publisher backend
# Copy from production .env (NOT committed).

# --- Runtime ---
PORT=8000
LOG_LEVEL=INFO
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
CORS_ORIGINS=https://douyin.toolnet.tech

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SSL_MODE=require

# --- YouTube Data API v3 ---
YOUTUBE_DATA_API_KEY=

# --- Facebook / Meta ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v19.0
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
FACEBOOK_MEDIA_MAX_BYTES=1000000000
FACEBOOK_REEL_MAX_SECONDS=90

# Per-page Page Access Tokens are encrypted and stored in the DB (see TOKEN_ENCRYPTION_KEY).
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- ToolNet AI ---
TOOLNET_AI_ENABLED=false
TOOLNET_BASE_URL=https://api.toolnet.ai/v1
TOOLNET_API_KEY=
TOOLNET_MODEL=gpt-4o-mini

# --- Scheduling / workers ---
SCHEDULER_ENABLED=true
PUBLISH_WORKER_ENABLED=true
AI_WORKER_ENABLED=true

# --- Media acquisition ---
FASTSAVER_BASE_URL=https://api.fastsaver.io/v1
FASTSAVER_API_KEY=

# --- Security (for encrypting stored Facebook Page tokens at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
